# Video shown in the About section (optional)
NEXT_PUBLIC_SUMMIT_VIDEO_URL=

# ── Airtable (server-side only — never prefix with NEXT_PUBLIC) ──
# Personal Access Token with data.records:read + data.records:write on the base
AIRTABLE_TOKEN=
# Base ID, looks like appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=
# Table name (or table ID). Defaults to "Registrations" if unset
AIRTABLE_REGISTRATIONS_TABLE=Registrations
# Table name (or table ID) for country-rep applications. Defaults to "Country Rep" if unset
AIRTABLE_COUNTRY_REP_TABLE=Country Rep
# Optional: field ID of the "Proof of Payment" attachment column
# (defaults to the current field; only set if you recreate that column)
AIRTABLE_PROOF_FIELD_ID=
